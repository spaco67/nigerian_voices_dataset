generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

type RecordingsMetadata {
  device  String
  isGuest Boolean
}

model datasets {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  /// Field referred in an index, but found no data to define the type.
  languageId Json?
  /// Field referred in an index, but found no data to define the type.
  version    Json?

  @@index([languageId], map: "languageId_1")
  @@index([version], map: "version_1")
}

model languages {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  code            String   @unique(map: "code_1")
  contributors    Int
  createdAt       DateTime @db.Date
  dialects        String[]
  name            String
  nativeName      String
  recordingsCount Int
  region          String
  updatedAt       DateTime @db.Date
  validatedCount  Int
}

model recordings {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  audioUrl            String
  category            String
  createdAt           DateTime           @db.Date
  duration            Int
  englishPhrase       String
  languageId          String
  metadata            RecordingsMetadata
  positiveValidations Int
  sampleRate          Int
  status              String
  translatedPhrase    String
  updatedAt           DateTime           @db.Date
  userId              String
  validations         Int

  @@index([languageId], map: "languageId_1")
  @@index([status], map: "status_1")
  @@index([userId], map: "userId_1")
  @@index([category], map: "category_1")
}

model user_profiles {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  /// Field referred in an index, but found no data to define the type.
  nativeLanguages Json?
  /// Field referred in an index, but found no data to define the type.
  region          Json?
  /// Field referred in an index, but found no data to define the type.
  userId          Json?  @unique(map: "userId_1")

  @@index([nativeLanguages], map: "nativeLanguages_1")
  @@index([region], map: "region_1")
}

model users {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt      DateTime @db.Date
  email          String   @unique(map: "email_1")
  hashedPassword String
  name           String
  points         Int
  role           String
  updatedAt      DateTime @db.Date
}

model validations {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  /// Field referred in an index, but found no data to define the type.
  recordingId Json?
  /// Field referred in an index, but found no data to define the type.
  userId      Json?

  @@index([recordingId], map: "recordingId_1")
  @@index([userId], map: "userId_1")
}
